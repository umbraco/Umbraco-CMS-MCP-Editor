{
  "name": "umbraco-mcp-editor-cms",
  "version": "18.0.0-beta.4",
  "type": "module",
  "description": "MCP server for umbraco-mcp-editor-cms",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./collections": "./dist/collections.js"
  },
  "bin": {
    "umbraco-mcp-editor-cms": "./dist/index.js"
  },
  "scripts": {
    "cleanup:orphans": "node scripts/kill-orphan-demosites.mjs",
    "clean": "rimraf dist",
    "build": "tsup --config tsup.config.ts",
    "compile": "tsc --noEmit",
    "watch": "tsup --config tsup.config.ts --watch",
    "start:umbraco": "bash scripts/start-umbraco.sh",
    "stop:umbraco": "bash scripts/stop-umbraco.sh",
    "umbraco:bootstrap": "bash scripts/bootstrap-demo-site.sh",
    "inspect": "npx @modelcontextprotocol/inspector@1 node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=__tests__ --runInBand --forceExit",
    "test:one": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:changed": "node scripts/test-changed.mjs",
    "test:evals": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/evals/jest.config.ts --forceExit",
    "test:all": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=__tests__ --runInBand --forceExit && node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/evals/jest.config.ts --forceExit",
    "test:e2e": "npx playwright test --config tests/hosted-e2e/playwright.config.ts",
    "dev:worker": "npx wrangler dev",
    "deploy:worker": "npx wrangler deploy"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "Umbraco",
    "MCP",
    "Model Context Protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.235",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@umbraco-cms/mcp-dev": "^18.1.2",
    "@umbraco-cms/mcp-hosted": "^1.0.0-beta.36",
    "@umbraco-cms/mcp-server-sdk": "^1.0.0-beta.36",
    "agents": "^0.21.0",
    "dotenv": "^17.4.2",
    "uuid": "^14.0.2",
    "yargs": "^18.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@jest/types": "^30.4.1",
    "@modelcontextprotocol/inspector": "^1.0.1",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/uuid": "^11.0.0",
    "@types/yargs": "^17.0.33",
    "commander": "^13.1.0",
    "jest": "^30.4.2",
    "msw": "^2.15.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "undici": "^8.10.0",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "commander": "^13.1.0"
  }
}
