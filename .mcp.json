{
  "mcpServers": {
    "umbraco-editor": {
      "command": "node",
      "args": ["dist/index.js"],
      "env": {
        "UMBRACO_CLIENT_ID": "umbraco-back-office-mcp",
        "UMBRACO_CLIENT_SECRET": "1234567890",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    },
    "umbraco-editor-hosted": {
      "type": "http",
      "url": "http://localhost:8787/mcp"
    }
  }
}
