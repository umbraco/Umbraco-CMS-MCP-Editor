# Copy to .env and load before `npm run start:azure` (or set in Container Apps).
PORT=8080
HOST=0.0.0.0

UMBRACO_BASE_URL=https://umbraco.example.com
# Optional HTTP override when the MCP host cannot trust the Umbraco TLS cert:
# UMBRACO_SERVER_URL=http://umbraco-internal:80

UMBRACO_OAUTH_CLIENT_ID=umbraco-editor-mcp-hosted
# UMBRACO_OAUTH_CLIENT_SECRET=

# openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=

# Azure Cache for Redis (omit for in-memory local dev)
# REDIS_URL=rediss://:PASSWORD@NAME.redis.cache.windows.net:6380

# UMBRACO_TOOL_MODES=content,media
# UMBRACO_READONLY=false
# UMBRACO_DRY_RUN=false
ENABLE_INFO_ENDPOINT=true
